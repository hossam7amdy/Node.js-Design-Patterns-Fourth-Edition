<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Subscribe — The Weekly Digest</title>
  <style>
    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
      color: #e0e0e0;
    }

    .card {
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      padding: 48px 40px;
      max-width: 440px;
      width: 90%;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      text-align: center;
      animation: fadeIn 0.5s ease-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(16px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .card h1 {
      font-size: 1.75rem;
      font-weight: 700;
      margin-bottom: 8px;
      background: linear-gradient(90deg, #a78bfa, #818cf8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .card p {
      font-size: 0.95rem;
      color: #a0a0b8;
      margin-bottom: 28px;
      line-height: 1.5;
    }

    .form-group {
      display: flex;
      gap: 10px;
    }

    .form-group input[type="email"] {
      flex: 1;
      padding: 14px 18px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-group input[type="email"]::placeholder {
      color: #7a7a94;
    }

    .form-group input[type="email"]:focus {
      border-color: #818cf8;
      box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.25);
    }

    .form-group button {
      padding: 14px 24px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #818cf8, #6366f1);
      color: #fff;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.2s;
      white-space: nowrap;
    }

    .form-group button:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 16px rgba(99, 102, 241, 0.45);
    }

    .form-group button:active {
      transform: translateY(0);
    }

    .back-link {
      display: inline-block;
      margin-top: 24px;
      color: #818cf8;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: color 0.2s;
    }

    .back-link:hover {
      color: #a78bfa;
    }
  </style>
</head>

<body>
  <div class="card">
    <h1>Stay in the Loop</h1>
    <p>Enter your email below to get the latest updates delivered straight to your inbox.</p>
    <form action="/subscribe" method="POST" class="form-group">
      <input type="email" name="email" id="email" aria-label="email" placeholder="you@example.com" required
        autocomplete="email" />
      <button type="submit" id="subscribe-btn">Subscribe</button>
    </form>
    <a href="/" class="back-link">← Back to home</a>
  </div>
</body>

</html>